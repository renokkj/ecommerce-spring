# Copie para .env e preencha. O arquivo .env não vai para o repositório.

# Banco de dados (usado pelo docker-compose e pela API)
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT: no mínimo 32 caracteres aleatórios
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URLs públicas
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mercado Pago (opcional). Use um access token de TESTE (começa com TEST-).
# Sem ele, a API usa o gateway de pagamento simulado.
MERCADOPAGO_ACCESS_TOKEN=
